<li class="item flexrow{{#if item.system.favorite }} favorite{{else }}{{#if (cprListContains sheet.options.collapsedSections "gearTab-ammo") }} hide{{/if }}{{/if }}"
    data-item-id="{{item._id}}"
    data-item-category="{{item.type}}"
    draggable="true">
  <div class="item-name gear-name"
       data-tooltip="{{localize (cprFindConfigValue "ammoTypes" item.system.type)}} | {{localize (cprFindConfigValue "ammoVarieties" item.system.variety)}}"
       alt="{{localize (cprFindConfigValue "ammoTypes" item.system.type)}} | {{localize (cprFindConfigValue "ammoVarieties" item.system.variety)}}">
    <a class="name gear-name-toggle flex-center"
       aria-expanded="false"
       aria-controls="gear-description-{{item._id}}">
      <img class="item-thumb" src="{{item.img}}"/>
      <span class="gear-item-name">{{ item.name }}</span>
    </a>
  </div>
  <div class="item-detail gear-amount">
    <div class="gear-amount-value">
      x
      <input name="item.system.amount"
             class="gear-amount-input"
             type="number"
             data-item-prop="item.system.amount"
             value="{{cprNumberFormat item.system.amount}}"/>
    </div>
  </div>
  <div class="item-detail gear-actions text-nowrap">
    {{> "systems/cyberpunk-red-core/templates/actor/character/right-pane/tabs/gear/cpr-gear-edit-button.hbs" item}}
    {{> "systems/cyberpunk-red-core/templates/actor/mixin/actions/cpr-actions.hbs" item}}
  </div>
  {{> "systems/cyberpunk-red-core/templates/actor/character/right-pane/tabs/gear/cpr-gear-description.hbs" item}}
</li>
