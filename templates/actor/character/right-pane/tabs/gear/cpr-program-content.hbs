{{#unless item.system.isInstalled}}
  <li class="item flexrow{{#if item.system.favorite }} favorite{{else }}{{#if (cprListContains sheet.options.collapsedSections "gearTab-gear") }} hide{{/if }}{{/if }}"
      data-item-id="{{item._id}}"
      data-item-category="{{item.type}}"
      draggable="true">
    <div class="item-name gear-name text-nowrap"
         data-tooltip="{{#if item.system.class }}{{localize (cprFindConfigValue "programClassList" item.system.class) }}{{/if }}">
      <a class="name gear-name-toggle flex-center"
         aria-expanded="false"
         aria-controls="gear-description-{{item._id}}">
        <img class="item-thumb" src="{{item.img}}"/>
        <span class="gear-item-name">{{ item.name }}</span>
      </a>
    </div>
    <div class="item-detail gear-actions text-nowrap">
      {{> "systems/cyberpunk-red-core/templates/actor/character/right-pane/tabs/gear/cpr-gear-edit-button.hbs" item}}
      {{> "systems/cyberpunk-red-core/templates/actor/mixin/actions/cpr-actions.hbs" item}}
    </div>
    {{> "systems/cyberpunk-red-core/templates/actor/character/right-pane/tabs/gear/cpr-gear-description.hbs" item}}
  </li>
{{/unless}}
